{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "types": ["vitest/globals", "jsdom"],
    "paths": {
      "vitest": ["./node_modules/vitest"],
      "vitest/*": ["./node_modules/vitest/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "tools/**/*.ts",
    "../../--testcode/prj-codev-viewer/tests/**/*.ts",
    "vite.config.ts"
  ]
}
